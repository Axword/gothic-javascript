{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NPCs",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "name", "role", "gender", "faction", "stats", "default_dialog", "dialogs", "crime_reaction", "spawn_position"],
    "properties": {
      "id": { "type": "string" },
      "name": { "type": "string" },
      "role": { "type": "string" },
      "gender": { "type": "string", "enum": ["male", "female"] },
      "faction": { "type": "string", "enum": ["old_order", "new_order", "neutral", "bandit"] },
      "title": { "type": "string" },
      "stats": { "type": "object" },
      "equipment": { "type": "object" },
      "inventory": { "type": "array", "items": { "type": "string" } },
      "default_dialog": { "type": "string" },
      "dialogs": { "type": "array", "items": { "type": "string" } },
      "crime_reaction": { "type": "object" },
      "teaching": { "type": "array" },
      "quest_ids": { "type": "array", "items": { "type": "string" } },
      "spawn_position": {
        "type": "object",
        "required": ["x", "y", "location_id"],
        "properties": {
          "x": { "type": "number" },
          "y": { "type": "number" },
          "location_id": { "type": "string" }
        }
      },
      "is_essential": { "type": "boolean" },
      "is_trainer": { "type": "boolean" },
      "is_merchant": { "type": "boolean" }
    }
  }
}
