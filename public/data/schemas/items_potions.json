{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Potions",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "name", "description", "category", "value", "weight", "icon", "effect", "effect_value"],
    "properties": {
      "id": { "type": "string" },
      "name": { "type": "string" },
      "description": { "type": "string" },
      "category": { "type": "string", "pattern": "^potion$" },
      "value": { "type": "integer", "minimum": 0 },
      "weight": { "type": "number", "minimum": 0 },
      "icon": { "type": "string" },
      "asset_path": { "type": "string" },
      "effect": { "type": "string", "enum": ["heal", "mana", "stamina", "buff_strength", "buff_dexterity", "poison", "antidote", "cure"] },
      "effect_value": { "type": "integer", "minimum": 0 },
      "effect_duration": { "type": "integer", "minimum": 0 }
    }
  }
}
