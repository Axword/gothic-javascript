[
  {
    "id": "dialog_beach_survivor_greeting",
    "title": "Powitanie na plaży",
    "npc_id": "npc_beach_survivor",
    "start_node": "start",
    "nodes": [
      {
        "id": "start",
        "npc_id": "npc_beach_survivor",
        "npc_line": "Hej! Żyjesz? No, chyba tak, skoro stoisz. Kolejny pechowiec wyrzucony przez morze.",
        "npc_emotion": "neutral",
        "responses": [
          { "id": "r1", "text": "Gdzie jestem? Co to za miejsce?", "next_node": "explain" },
          { "id": "r2", "text": "Masz coś do jedzenia? Umieram z głodu.", "next_node": "food", "conditions": [] },
          { "id": "r3", "text": "Nie mam czasu na gadanie. Idę.", "next_node": null, "is_leave": true }
        ]
      },
      {
        "id": "explain",
        "npc_id": "npc_beach_survivor",
        "npc_line": "Kresy Północne. Najgorsze miejsce do życia na całym kontynencie. Na północ traktem trafisz do Grodu Straży - tam rządzą wojskowi. Na wschód, przez las, są Wolne Chaty - wolność za cenę braku bezpieczeństwa.",
        "npc_emotion": "neutral",
        "responses": [
          { "id": "r1", "text": "Straż? Wolni? O co chodzi?", "next_node": "explain_factions" },
          { "id": "r2", "text": "Dzięki. Idę do Grodu.", "next_node": "quest_hint", "actions": [{ "type": "set_flag", "target": "heard_about_fort", "value": true }] },
          { "id": "r3", "text": "Dzięki. Idę do Wolnych Chat.", "next_node": "quest_hint", "actions": [{ "type": "set_flag", "target": "heard_about_village", "value": true }] },
          { "id": "r4", "text": "Muszę znaleźć jakieś wyposażenie.", "next_node": "equipment_hint" },
          { "id": "r_leave", "text": "Do widzenia.", "next_node": null, "is_leave": true }
        ]
      },
      {
        "id": "explain_factions",
        "npc_id": "npc_beach_survivor",
        "npc_line": "Stary Porządek - Straż w Grodzie. Komendant trzyma wszystkich krótko, ale bandyci nie podchodzą pod mury. Nowy Porządek - Wolne Chaty. Sęp i jego ludzie, biją, kradną, ale każdy może robić co chce. Wybieraj mądrze, bo drugi raz nie będziesz miał szansy.",
        "npc_emotion": "sarcastic",
        "responses": [
          { "id": "r1", "text": "Rozumiem. Dzięki za radę.", "actions": [{ "type": "set_flag", "target": "heard_about_factions", "value": true }], "next_node": "quest_hint" },
          { "id": "r2", "text": "Do zobaczenia.", "next_node": null, "is_leave": true }
        ]
      },
      {
        "id": "food",
        "npc_id": "npc_beach_survivor",
        "npc_line": "Mam tylko suchy chleb, ale za darmo nic nie daję. Masz może parę groszy? Albo zrób coś dla mnie - znajdź mój nóż, zgubiłem go gdzieś na plaży.",
        "npc_emotion": "neutral",
        "responses": [
          { "id": "r1", "text": "Mam parę groszy (zapłać 5)", "next_node": "pay_food", "conditions": [{ "type": "has_item", "item_id": "misc_gold" }], "actions": [{ "type": "remove_item", "target": "misc_gold", "value": 5 }, { "type": "give_item", "target": "potion_healing_small" }] },
          { "id": "r2", "text": "Pomogę znaleźć nóż.", "actions": [{ "type": "set_flag", "target": "quest_found_knife", "value": true }], "next_node": "knife_quest" },
          { "id": "r3", "text": "Nie, dzięki.", "next_node": "start" }
        ]
      },
      {
        "id": "pay_food",
        "npc_id": "npc_beach_survivor",
        "npc_line": "Dobra, trzymaj. Niewiele, ale zawsze coś. A jakbyś znalazł mój nóż, daj znać.",
        "npc_emotion": "neutral",
        "responses": [
          { "id": "r1", "text": "Dzięki.", "next_node": null, "is_leave": true }
        ]
      },
      {
        "id": "knife_quest",
        "npc_id": "npc_beach_survivor",
        "npc_line": "Noża szukaj w okolicy wraku na południu. Biała rękojeść, łatwo poznać. Jak znajdziesz, przynieś, a może wyciągnę cię z biedy.",
        "npc_emotion": "neutral",
        "actions": [{ "type": "set_flag", "target": "knife_quest_active", "value": true }],
        "responses": [
          { "id": "r1", "text": "Znajdę go.", "next_node": null, "is_leave": true },
          { "id": "r2", "text": "A coś więcej o tym miejscu?", "next_node": "explain" }
        ]
      },
      {
        "id": "equipment_hint",
        "npc_id": "npc_beach_survivor",
        "npc_line": "Rozejrzyj się po plaży. Morze wyrzuciło różne rzeczy. Widziałem coś błyszczącego w piasku na północy. No i ten nóż... gdybyś go znalazł, mógłbyś go zatrzymać, jakbyś mnie poratował groszem.",
        "npc_emotion": "neutral",
        "responses": [
          { "id": "r1", "text": "Poszukam.", "next_node": null, "is_leave": true },
          { "id": "r2", "text": "Opowiedz więcej o frakcjach.", "next_node": "explain_factions" }
        ]
      },
      {
        "id": "quest_hint",
        "npc_id": "npc_beach_survivor",
        "npc_line": "Idź traktem na północ. W Grodzie Straży pytaj o Komendanta. W Wolnych Chatach - o Sępa. I uważaj na wilki w lesie. Powodzenia, chłopie. Będzie ci potrzebne.",
        "npc_emotion": "neutral",
        "actions": [{ "type": "start_quest", "target": "quest_main_arrival" }],
        "responses": [
          { "id": "r1", "text": "Dzięki. Ruszam.", "next_node": null, "is_leave": true }
        ]
      }
    ]
  }
]
